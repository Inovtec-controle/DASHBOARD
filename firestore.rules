rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /kanban/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;

      // Documents individuels d'incidents : hors du gros document personnel
      // afin de respecter la limite Firestore de 1 Mio par document.
      // Aucune lecture possible par un autre compte authentifié.
      match /agentIncidents/{incidentKey} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /discipline/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /chantiers/{chantierId} {
      allow read, create, update, delete: if signedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
